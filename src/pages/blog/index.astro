---
import { getCollection } from 'astro:content';
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import { formatDate } from '../../utils/formatDate';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<PortfolioLayout title="Blog" description="Technical articles, tutorials, and notes.">
    <section class="blog-page">
        <header class="page-header">
            <h1 class="page-title">Blog</h1>
            <p class="page-subtitle">Technical articles, tutorials, and insights.</p>
        </header>

        <div class="grid">
            {posts.map(({ data, slug }) => (
                <article class="card">
                    <a href={`/blog/${slug}/`} class="card-link">
                        <h2 class="card-title">{data.title}</h2>
                        <p class="card-desc">{data.description}</p>
                        <div class="meta">
                            <time datetime={data.publishDate.toISOString()}>
                                {formatDate(data.publishDate)}
                            </time>
                        </div>
                    </a>
                    {data.tags?.length ? (
                        <ul class="tags">
                            {data.tags.slice(0, 5).map(t => (
                                <li>
                                    <a href={`/tags/${encodeURIComponent(t)}`} class="tag-link">
                                        {t}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    ) : null}
                </article>
            ))}
        </div>

        {posts.length > 6 && (
            <p class="pagination-note">Showing all {posts.length} posts. Pagination coming as the archive grows.</p>
        )}
    </section>
</PortfolioLayout>

<style>
    .page-header {
        margin-bottom: var(--space-10);
    }

    .page-title {
        font-size: 2.25rem;
        font-weight: 800;
        color: var(--color-text);
        margin: 0 0 var(--space-2);
    }

    .page-subtitle {
        font-size: 1rem;
        color: var(--color-text-secondary);
        margin: 0;
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 480px), 1fr));
        gap: var(--space-6);
    }

    .grid > *:last-child:nth-child(odd) {
        max-width: 480px;
    }

    @media (max-width: 900px) {
        .grid {
            grid-template-columns: 1fr;
        }

        .grid > *:last-child:nth-child(odd) {
            max-width: none;
        }
    }

    .card {
        padding: var(--space-6);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-xl);
        background: var(--color-bg-secondary);
        transition: all var(--transition-fast);
        position: relative;
        display: flex;
        flex-direction: column;
    }

    .card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, var(--color-primary), var(--color-accent-cyan));
        opacity: 0;
        transition: opacity var(--transition-fast);
        border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    }

    .card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 32px rgba(14, 165, 233, 0.15);
        border-color: var(--color-primary);
    }

    .card:hover::before {
        opacity: 1;
    }

    .card-link {
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2);
        list-style: none;
        margin: var(--space-3) 0 0;
        padding: 0;
    }

    .tags li {
        display: flex;
    }

    .card-title {
        margin: 0 0 var(--space-3);
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--color-text);
        line-height: 1.4;
        transition: color var(--transition-fast);
    }

    .card:hover .card-title {
        color: var(--color-primary);
    }

    .card-desc {
        color: var(--color-text-secondary);
        line-height: 1.6;
        margin: 0 0 var(--space-4);
        font-size: 0.9375rem;
        flex: 1;
    }

    .meta {
        display: flex;
        align-items: center;
        font-size: 0.875rem;
        color: var(--color-text-secondary);
        margin-top: auto;
        padding-top: var(--space-4);
        border-top: 1px solid var(--color-border);
    }

    .tag-link {
        padding: var(--space-1) var(--space-3);
        background: var(--color-bg-tertiary);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-full);
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--color-text-secondary);
        text-decoration: none;
        transition: all var(--transition-fast);
    }

    .tag-link:hover {
        border-color: var(--color-primary);
        color: var(--color-primary);
        background: rgba(14, 165, 233, 0.1);
    }

    time {
        font-family: var(--font-mono);
        font-size: 0.8125rem;
    }

    .pagination-note {
        margin-top: var(--space-8);
        font-size: 0.875rem;
        color: var(--color-text-secondary);
        text-align: center;
    }
</style>
