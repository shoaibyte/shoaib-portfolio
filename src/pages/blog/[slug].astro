---
import { getCollection, getEntry } from 'astro:content';
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';

export async function getStaticPaths() {
    const posts = await getCollection('blog');
    return posts.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const post = await getEntry('blog', slug);
if (!post) { throw new Error(`Post not found: ${slug}`); }
const { data } = post;
const { Content } = await post.render();
---

<PortfolioLayout title={data.title} description={data.description}>
    <article class="blog-post">
        <header class="post-header">
            <div class="header-content">
                <h1 class="post-title">{data.title}</h1>
                <p class="post-description">{data.description}</p>
                
                <div class="post-meta">
                    <div class="meta-item">
                        <svg class="meta-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                        <time datetime={data.publishDate.toISOString()}>
                            {new Intl.DateTimeFormat('en-US', { 
                                month: 'short', 
                                day: 'numeric', 
                                year: 'numeric' 
                            }).format(data.publishDate)}
                        </time>
                    </div>
                    {data.updatedDate && (
                        <div class="meta-item">
                            <svg class="meta-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                <circle cx="12" cy="10" r="3"></circle>
                            </svg>
                            <span>Updated {new Intl.DateTimeFormat('en-US', { 
                                month: 'short', 
                                day: 'numeric', 
                                year: 'numeric' 
                            }).format(data.updatedDate)}</span>
                        </div>
                    )}
                    {data.tags && data.tags.length > 0 && (
                        <div class="meta-item tags-container">
                            {data.tags.map(tag => (
                                <span class="tag">{tag}</span>
                            ))}
                        </div>
                    )}
                </div>
            </div>
        </header>

        <div class="post-content">
            <Content />
        </div>
    </article>
</PortfolioLayout>

<style>
    /* Isolate blog post content from global resets */
    .blog-post {
        max-width: min(800px, 95%);
        margin: 0 auto;
        padding: var(--space-12) 0 var(--space-16);
        isolation: isolate;
    }

    /* Reset and isolate post content area */
    .post-content {
        isolation: isolate;
    }

    /* Ensure all elements inside post-content respect our styles */
    .post-content * {
        box-sizing: border-box;
    }

    /* Header Section - Clean and Minimal */
    .post-header {
        margin-bottom: var(--space-20);
        padding-bottom: var(--space-10);
        border-bottom: 1px solid var(--color-border);
        position: relative;
    }

    .post-header::after {
        content: '';
        position: absolute;
        bottom: -1px;
        left: 0;
        width: 100px;
        height: 2px;
        background: linear-gradient(90deg, var(--color-primary), transparent);
        border-radius: var(--radius-full);
    }

    .header-content {
        display: flex;
        flex-direction: column;
        gap: var(--space-5);
    }

    .post-title {
        margin: 0;
        font-size: clamp(2.25rem, 5vw, 3.5rem);
        font-weight: 800;
        line-height: 1.1;
        color: var(--color-text);
        letter-spacing: -0.03em;
        background: linear-gradient(135deg, var(--color-text) 0%, var(--color-primary) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        max-width: 90%;
    }

    .post-description {
        font-size: clamp(1.0625rem, 2vw, 1.1875rem);
        line-height: 1.75;
        color: var(--color-text-secondary);
        margin: 0;
        font-weight: 400;
        max-width: 85ch;
        opacity: 0.9;
    }

    .post-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-5);
        margin-top: var(--space-4);
        padding-top: var(--space-4);
        border-top: 1px solid var(--color-border);
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        font-size: 0.875rem;
        color: var(--color-text-secondary);
        font-family: var(--font-mono);
        opacity: 0.8;
    }

    .meta-icon {
        width: 14px;
        height: 14px;
        color: var(--color-primary);
        opacity: 0.7;
        flex-shrink: 0;
    }

    .tags-container {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        margin-left: auto;
    }

    .tag {
        padding: var(--space-1) var(--space-3);
        background: transparent;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-full);
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--color-text-secondary);
        transition: all var(--transition-fast);
        font-family: var(--font-sans);
        opacity: 0.8;
        text-transform: lowercase;
    }

    .tag:hover {
        border-color: var(--color-primary);
        color: var(--color-primary);
        background: rgba(14, 165, 233, 0.08);
        opacity: 1;
        transform: translateY(-1px);
    }

    /* Content Section - Clean Typography */
    .post-content {
        padding-top: var(--space-6);
    }

    /* Typography Improvements - Better Hierarchy */
    .post-content :where(h2) {
        margin-top: var(--space-20);
        margin-bottom: var(--space-6);
        font-size: clamp(1.625rem, 4vw, 2rem);
        font-weight: 700;
        line-height: 1.25;
        color: var(--color-text);
        scroll-margin-top: var(--space-8);
        letter-spacing: -0.02em;
        position: relative;
        padding-bottom: var(--space-4);
    }

    .post-content :where(h2:first-of-type) {
        margin-top: 0;
    }

    .post-content :where(h2)::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 50px;
        height: 2px;
        background: var(--color-primary);
        border-radius: var(--radius-full);
        opacity: 0.6;
    }

    .post-content :where(h2 + p) {
        margin-top: var(--space-6);
    }

    .post-content :where(h3) {
        margin-top: var(--space-16);
        margin-bottom: var(--space-5);
        font-size: clamp(1.375rem, 3vw, 1.625rem);
        font-weight: 600;
        line-height: 1.3;
        color: var(--color-text);
        letter-spacing: -0.015em;
    }

    .post-content :where(h3 + p) {
        margin-top: var(--space-5);
    }

    .post-content :where(h4) {
        margin-top: var(--space-12);
        margin-bottom: var(--space-4);
        font-size: clamp(1.125rem, 2vw, 1.375rem);
        font-weight: 600;
        color: var(--color-text);
        letter-spacing: -0.01em;
    }

    .post-content :where(h4 + p) {
        margin-top: var(--space-4);
    }

    .post-content p {
        margin: var(--space-7) 0 !important;
        line-height: 1.85;
        color: var(--color-text);
        font-size: clamp(1rem, 1.5vw, 1.0625rem);
        text-align: left;
        letter-spacing: -0.01em;
        word-spacing: 0.02em;
        opacity: 0.95;
    }

    .post-content p:first-of-type {
        margin-top: 0 !important;
        font-size: clamp(1.0625rem, 2vw, 1.1875rem);
        line-height: 1.8;
    }

    .post-content p:last-of-type {
        margin-bottom: 0 !important;
    }

    /* Lists - Higher specificity to override global resets */
    .post-content ul,
    .post-content ol {
        margin: var(--space-8) 0 !important;
        padding-left: 0 !important;
        list-style: none !important;
        line-height: 1.85;
    }

    .post-content ul {
        padding-left: calc(var(--space-6) + var(--space-8) + var(--space-8)) !important;
    }

    .post-content ol {
        padding-left: calc(var(--space-8) + var(--space-8) + var(--space-8)) !important;
        counter-reset: list-counter;
    }

    .post-content li {
        margin: var(--space-5) 0 !important;
        color: var(--color-text);
        line-height: 1.85;
        padding-left: var(--space-6) !important;
        position: relative;
        list-style: none !important;
        display: list-item;
        opacity: 0.95;
    }

    /* Custom bullet points for unordered lists */
    .post-content ul li::before {
        content: '•' !important;
        position: absolute;
        left: var(--space-8) !important;
        color: var(--color-primary);
        font-size: 1.2em;
        font-weight: 600;
        line-height: 1.8;
        display: inline-block;
    }

    /* Custom numbering for ordered lists */
    .post-content ol li {
        counter-increment: list-counter;
        padding-left: var(--space-8) !important;
    }

    .post-content ol li::before {
        content: counter(list-counter) '.' !important;
        position: absolute;
        left: var(--space-8) !important;
        color: var(--color-primary);
        font-weight: 600;
        line-height: 1.8;
        min-width: var(--space-6);
        text-align: right;
        display: inline-block;
    }

    .post-content li p {
        margin: var(--space-3) 0;
    }

    /* Nested lists */
    .post-content li ul,
    .post-content li ol {
        margin-top: var(--space-3) !important;
        margin-bottom: var(--space-3) !important;
    }

    .post-content li ul {
        padding-left: calc(var(--space-6) + var(--space-8) + var(--space-8)) !important;
    }

    .post-content li ol {
        padding-left: calc(var(--space-8) + var(--space-8) + var(--space-8)) !important;
    }

    /* Strong/Bold */
    .post-content :where(strong) {
        font-weight: 600;
        color: var(--color-text);
        background: linear-gradient(135deg, transparent 0%, rgba(14, 165, 233, 0.1) 50%, transparent 100%);
        padding: 0 2px;
    }

    /* Code */
    .post-content :where(code) {
        background: var(--color-bg-secondary);
        padding: 0.25em 0.5em;
        border-radius: var(--radius);
        font-family: var(--font-mono);
        font-size: 0.9em;
        color: var(--color-primary);
        border: 1px solid var(--color-border);
        font-weight: 500;
    }

    .post-content :where(pre) {
        margin: var(--space-10) 0;
        padding: var(--space-6);
        background: var(--color-bg-secondary);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        overflow-x: auto;
        line-height: 1.7;
        position: relative;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .post-content :where(pre)::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: var(--color-primary);
        border-radius: var(--radius-lg) var(--radius-lg) 0 0;
        opacity: 0.5;
    }

    .post-content :where(pre code) {
        background: transparent;
        padding: 0;
        border: none;
        color: var(--color-text);
        font-size: 0.875rem;
        font-weight: 400;
    }

    /* Blockquotes */
    .post-content :where(blockquote) {
        margin: var(--space-10) 0;
        padding: var(--space-6) var(--space-8);
        border-left: 3px solid var(--color-primary);
        background: var(--color-bg-secondary);
        border-radius: var(--radius-lg);
        font-style: italic;
        color: var(--color-text-secondary);
        position: relative;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        opacity: 0.9;
    }

    .post-content :where(blockquote)::before {
        content: '"';
        position: absolute;
        top: var(--space-4);
        left: var(--space-6);
        font-size: 3.5rem;
        color: var(--color-primary);
        opacity: 0.15;
        font-family: Georgia, serif;
        line-height: 1;
    }

    /* Links */
    .post-content :where(a) {
        color: var(--color-primary);
        text-decoration: none;
        border-bottom: 1px solid transparent;
        transition: all var(--transition-fast);
        font-weight: 500;
    }

    .post-content :where(a:hover) {
        border-bottom-color: var(--color-primary);
        color: var(--color-primary-light);
    }

    /* Images */
    .post-content :where(img) {
        margin: var(--space-10) 0;
        border-radius: var(--radius-xl);
        border: 1px solid var(--color-border);
        max-width: 100%;
        height: auto;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
        display: block;
    }

    /* Tables */
    .post-content :where(table) {
        width: 100%;
        margin: var(--space-8) 0;
        border-collapse: collapse;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        overflow: hidden;
        background: var(--color-bg-secondary);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }

    .post-content :where(th, td) {
        padding: var(--space-4) var(--space-5);
        text-align: left;
        border-bottom: 1px solid var(--color-border);
    }

    .post-content :where(th) {
        background: var(--color-bg-tertiary);
        font-weight: 600;
        color: var(--color-text);
        font-size: 0.9375rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-size: 0.8125rem;
    }

    .post-content :where(tr:last-child td) {
        border-bottom: none;
    }

    .post-content :where(tr:hover) {
        background: rgba(14, 165, 233, 0.05);
    }

    /* Sequence diagram images */
    .post-content :where(.sequence-diagram) {
        margin: var(--space-10) 0;
        border-radius: var(--radius-xl);
        border: 1px solid var(--color-border);
        background: var(--color-bg-secondary);
        padding: var(--space-6);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
        width: 100%;
        overflow-x: auto;
    }

    .post-content :where(.sequence-diagram img) {
        margin: 0;
        border: none;
        box-shadow: none;
        border-radius: var(--radius-lg);
        width: 100%;
        min-width: 800px;
        height: auto;
        display: block;
    }

    /* Horizontal Rules */
    .post-content :where(hr) {
        margin: var(--space-12) 0;
        border: none;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--color-border), transparent);
    }

    /* Section Dividers */
    .post-content :where(h2 + hr),
    .post-content :where(h3 + hr) {
        margin-top: calc(var(--space-8) * -1);
    }

    /* Responsive Design */
    @media (max-width: 768px) {
        .blog-post {
            padding: var(--space-8) 0 var(--space-12);
        }

        .post-header {
            margin-bottom: var(--space-16);
            padding-bottom: var(--space-8);
        }

        .post-title {
            font-size: 1.875rem;
            max-width: 100%;
        }

        .post-description {
            font-size: 1.0625rem;
        }

        .post-meta {
            flex-direction: column;
            align-items: flex-start;
            gap: var(--space-4);
            padding-top: var(--space-4);
        }

        .tags-container {
            margin-left: 0;
            width: 100%;
        }

        .post-content :where(h2) {
            font-size: 1.625rem;
            margin-top: var(--space-16);
        }

        .post-content :where(h3) {
            font-size: 1.375rem;
            margin-top: var(--space-12);
        }

        .post-content :where(h4) {
            font-size: 1.125rem;
        }

        .post-content p {
            font-size: 1rem;
            line-height: 1.8;
        }

        .post-content :where(pre) {
            padding: var(--space-5);
            font-size: 0.8125rem;
            margin: var(--space-8) 0;
        }

        .post-content ul {
            padding-left: calc(var(--space-5) + var(--space-8) + var(--space-8)) !important;
        }

        .post-content ol {
            padding-left: calc(var(--space-6) + var(--space-8) + var(--space-8)) !important;
        }

        .post-content li {
            padding-left: var(--space-5) !important;
        }

        .post-content ul li::before {
            left: var(--space-8) !important;
        }

        .post-content ol li {
            padding-left: var(--space-6) !important;
        }

        .post-content ol li::before {
            left: var(--space-8) !important;
        }

        .post-content li ul {
            padding-left: calc(var(--space-5) + var(--space-8) + var(--space-8)) !important;
        }

        .post-content li ol {
            padding-left: calc(var(--space-6) + var(--space-8) + var(--space-8)) !important;
        }
    }

    @media (max-width: 480px) {
        .blog-post {
            padding: var(--space-6) 0 var(--space-10);
        }

        .post-title {
            font-size: 1.625rem;
        }

        .post-content :where(h2) {
            font-size: 1.5rem;
            margin-top: var(--space-12);
        }

        .post-content :where(h3) {
            font-size: 1.25rem;
            margin-top: var(--space-10);
        }

        .post-content p {
            font-size: 0.9375rem;
        }
    }

    /* Print Styles */
    @media print {
        .post-header {
            border-bottom: 1px solid var(--color-border);
            padding-bottom: var(--space-6);
        }

        .post-content :where(pre) {
            page-break-inside: avoid;
        }

        .post-content :where(img) {
            page-break-inside: avoid;
        }
    }
</style>
