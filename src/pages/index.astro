---
// src/pages/index.astro
import { getCollection } from 'astro:content';
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import TechStack from '../components/common/TechStack.astro';
import GitHubStats from '../components/common/GitHubStats.astro';
import { SITE, SOCIAL_LINKS } from '../config/site';
import { formatDate } from '../utils/formatDate';

// Get latest blog posts and projects
const blogPosts = await getCollection('blog', ({ data }) => {
	return !data.draft;
});

const projects = await getCollection('projects');

// Sort by publish date (newest first)
const latestBlogPosts = blogPosts
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
	.slice(0, 4);

const latestProjects = projects
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
	.slice(0, 4);

const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: SITE.name,
	jobTitle: 'Backend Engineer',
	url: SITE.url,
	sameAs: [SOCIAL_LINKS.github, SOCIAL_LINKS.linkedin, SOCIAL_LINKS.twitter],
	knowsAbout: ['Go', 'Distributed Systems', 'Event-Driven Architecture', 'AWS', 'Observability'],
};
---

<PortfolioLayout
	title="Shoaib Hasan - Backend Engineer · Go & Distributed Systems"
	description="Backend Engineer with 4+ years building Go-first distributed systems — auth, billing, and observability at scale. 30K+ concurrent users on AWS."
	isHome={true}
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
	</Fragment>
	<!-- Hero Section -->
	<section class="hero fade-in">
		<div class="hero-content">
			<div class="hero-greeting">
				<h1>Hey, I'm <span class="hero-name">Shoaib</span>!</h1>
			</div>
			
			<div class="hero-roles">
				<span class="role-text" id="role-text" aria-live="polite" aria-label="Backend Engineer">Backend Engineer</span>
				<span class="role-cursor" aria-hidden="true">|</span>
			</div>

			<div class="hero-achievement-badge" role="status" aria-label="Achievement: Excellence Award for Technical Brilliance, Placepoint 2025">
				<span class="badge-icon" aria-hidden="true">🏆</span>
				<span class="badge-text">Excellence Award for Technical Brilliance · Placepoint 2025</span>
			</div>

			<div class="hero-metrics">
				<div class="metric-item">
					<span class="metric-value" data-prefix="$" data-value="500" data-suffix="K" data-decimals="0">$500K</span>
					<span class="metric-label">Billing Revenue</span>
				</div>
				<div class="metric-divider" aria-hidden="true">|</div>
				<div class="metric-item">
					<span class="metric-value" data-value="99.9" data-suffix="%" data-decimals="1">99.9%</span>
					<span class="metric-label">Uptime</span>
				</div>
				<div class="metric-divider" aria-hidden="true">|</div>
				<div class="metric-item">
					<span class="metric-value" data-value="30" data-suffix="K+" data-decimals="0">30K+</span>
					<span class="metric-label">Users</span>
				</div>
			</div>

			<div class="hero-location">
				<span class="location-icon">📍</span>
				<span class="location-text">Dhaka, Bangladesh 🇧🇩</span>
			</div>

			<p class="hero-description">
				Backend Engineer with 4+ years building Go-first distributed systems — auth, billing, and
				observability at scale. Currently at Placepoint, serving 30K+ concurrent users on AWS.
			</p>

			<div class="hero-actions">
				<a href="/projects" class="btn btn-primary">
					<span>🚀</span>
					View Projects
				</a>
				<a href="/blog" class="btn btn-secondary">
					<span>📝</span>
					Read Blog
				</a>
				<a href="mailto:shoaib.hasan1801@gmail.com" class="btn btn-tertiary">
					<span>📧</span>
					Get in Touch
				</a>
			</div>
		</div>

		<div class="hero-avatar fade-in fade-in-delay-1">
			<div class="avatar-wrapper">
				<img
					src="/profile.jpeg"
					alt="Shoaib Hasan"
					class="avatar"
					width="280"
					height="280"
					loading="eager"
					fetchpriority="high"
				>
				<div class="avatar-border"></div>
				<div class="floating-icons">
					<div class="floating-icon icon-aws">☁️</div>
					<div class="floating-icon icon-docker">🐳</div>
					<div class="floating-icon icon-k8s">⚙️</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Achievements Section -->
	<section id="achievements" class="achievements-section fade-in fade-in-delay-2">
		<h2 class="section-title">Achievements & Recognition</h2>
		<div class="achievements-grid" role="list">
			<div class="achievement-card" role="listitem" tabindex="0">
				<div class="achievement-icon" aria-hidden="true">🌟</div>
				<h3 class="achievement-title">Placepoint 2025</h3>
				<p class="achievement-subtitle">Excellence Award</p>
				<p class="achievement-description">Technical Brilliance</p>
			</div>
			<div class="achievement-card" role="listitem" tabindex="0">
				<div class="achievement-icon" aria-hidden="true">🏆</div>
				<h3 class="achievement-title">IBCOL 2023</h3>
				<p class="achievement-subtitle">6th Place International</p>
				<p class="achievement-description">Blockchain Olympiad</p>
				<p class="achievement-location">Amsterdam, Netherlands</p>
			</div>
			<div class="achievement-card" role="listitem" tabindex="0">
				<div class="achievement-icon" aria-hidden="true">💰</div>
				<h3 class="achievement-title">Billing Platform</h3>
				<p class="achievement-subtitle">$500K Revenue</p>
				<p class="achievement-description">Event-Driven Payment System</p>
			</div>
			<div class="achievement-card" role="listitem" tabindex="0">
				<div class="achievement-icon" aria-hidden="true">⚡</div>
				<h3 class="achievement-title">Performance Expert</h3>
				<p class="achievement-subtitle">99.9% System Uptime</p>
				<p class="achievement-description">30% Latency Reduction</p>
				<p class="achievement-location">Scalable Architecture</p>
			</div>
		</div>
	</section>

	<!-- Tech Stack Section -->
	<TechStack />

	<!-- GitHub Stats Section -->
	<GitHubStats />

	<!-- Content Grid -->
	<div class="content-grid">
		<!-- Notes Section -->
		<section class="content-section fade-in fade-in-delay-2">
			<div class="section-header">
				<h2 class="section-title">Latest Posts</h2>
				<a href="/blog" class="see-all">See All</a>
			</div>
			<p class="section-subtitle">Technical articles, tutorials, and insights.</p>

			<div class="post-list">
				{latestBlogPosts.map((post) => (
					<a href={`/blog/${post.slug}`} class="post-card">
						<h3 class="post-title">{post.data.title}</h3>
						<time class="post-date" datetime={post.data.publishDate.toISOString()}>
							{formatDate(post.data.publishDate)}
						</time>
						{post.data.description && (
							<p class="post-description">{post.data.description}</p>
						)}
						{post.data.tags && post.data.tags.length > 0 && (
							<div class="post-tags">
								{post.data.tags.slice(0, 3).map((tag) => (
									<span class="tag">{tag}</span>
								))}
							</div>
						)}
					</a>
				))}
			</div>
		</section>

		<!-- Projects Section -->
		<section class="content-section fade-in fade-in-delay-3">
			<div class="section-header">
				<h2 class="section-title">Featured Projects</h2>
				<a href="/projects" class="see-all">See All</a>
			</div>
			<p class="section-subtitle">Things I've built and open-sourced.</p>

			<div class="post-list">
				{latestProjects.map((project) => (
					<a href={`/projects/${project.slug}`} class="post-card project-card">
						<div class="project-header">
							<h3 class="post-title">{project.data.title}</h3>
							{project.data.status && (
								<span class={`status-badge status-${project.data.status}`}>
									{project.data.status}
								</span>
							)}
						</div>
						{project.data.description && (
							<p class="post-description">{project.data.description}</p>
						)}
						{project.data.tags && project.data.tags.length > 0 && (
							<div class="post-tags">
								{project.data.tags.slice(0, 4).map((tag) => (
									<span class="tag tech-tag">{tag}</span>
								))}
							</div>
						)}
						<div class="project-card-footer">
							<time class="post-date">
								{project.data.publishDate.toLocaleDateString('en-US', {
									year: 'numeric',
									month: 'short'
								})}
							</time>
							<div class="project-links">
								{project.data.github && (
									<a
										href={project.data.github}
										class="project-link-icon"
										target="_blank"
										rel="noopener noreferrer"
										aria-label="GitHub"
										onclick="event.stopPropagation()"
									>
										🐙
									</a>
								)}
								{project.data.demo && (
									<a
										href={project.data.demo}
										class="project-link-icon"
										target="_blank"
										rel="noopener noreferrer"
										aria-label="Live Demo"
										onclick="event.stopPropagation()"
									>
										🚀
									</a>
								)}
							</div>
						</div>
					</a>
				))}
			</div>
		</section>
	</div>
</PortfolioLayout>

<style>
	/* Hero Section */
	.hero {
		display: grid;
		grid-template-columns: 1fr 320px;
		gap: var(--space-12);
		align-items: center;
		margin-bottom: var(--space-16);
	}

	.hero-content h1 {
		font-size: 3.5rem;
		font-weight: 800;
		line-height: 1.1;
		margin-bottom: var(--space-4);
		color: var(--color-text);
	}

	.hero-name {
		background: linear-gradient(135deg, var(--color-primary), var(--color-accent-cyan));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.hero-roles {
		font-size: 1.5rem;
		font-weight: 600;
		color: var(--color-text-secondary);
		margin-bottom: var(--space-6);
		min-height: 2rem;
		font-family: var(--font-mono);
	}

	.role-text {
		color: var(--color-primary);
	}

	.role-cursor {
		animation: blink 1s infinite;
		margin-left: 4px;
	}

	@keyframes blink {
		0%, 50% { opacity: 1; }
		51%, 100% { opacity: 0; }
	}

	.hero-achievement-badge {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-2) var(--space-4);
		background: linear-gradient(135deg, rgba(14, 165, 233, 0.1), rgba(6, 182, 212, 0.1));
		border: 1px solid var(--color-primary);
		border-radius: var(--radius-full);
		margin-bottom: var(--space-6);
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--color-primary);
		position: relative;
		overflow: hidden;
		animation: pulse 3s ease-in-out infinite;
	}

	.hero-achievement-badge::before {
		content: '';
		position: absolute;
		top: 0;
		left: -100%;
		width: 100%;
		height: 100%;
		background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
		animation: shine 3s infinite;
	}

	.badge-icon {
		font-size: 1.125rem;
	}

	.hero-metrics {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		margin-bottom: var(--space-6);
		flex-wrap: wrap;
	}

	.metric-item {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}

	.metric-value {
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--color-accent-green);
		font-family: var(--font-mono);
	}

	.metric-label {
		font-size: 0.75rem;
		color: var(--color-text-secondary);
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.metric-divider {
		color: var(--color-text-secondary);
		opacity: 0.3;
	}

	.hero-location {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-2) var(--space-4);
		background: var(--color-bg-secondary);
		border-radius: var(--radius-full);
		margin-bottom: var(--space-6);
		font-size: 0.875rem;
		color: var(--color-text-secondary);
	}

	.location-icon {
		font-size: 1rem;
	}

	.hero-description {
		font-size: 1.125rem;
		color: var(--color-text-secondary);
		line-height: 1.7;
		margin-bottom: var(--space-8);
		max-width: 600px;
	}

	.hero-actions {
		display: flex;
		gap: var(--space-4);
		flex-wrap: wrap;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-3) var(--space-5);
		border: none;
		border-radius: var(--radius-lg);
		font-family: inherit;
		font-size: 0.875rem;
		font-weight: 500;
		text-decoration: none;
		cursor: pointer;
		transition: all var(--transition-fast);
	}

	.btn:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: 2px;
	}

	.btn-primary {
		background: var(--color-primary);
		color: white;
	}

	.btn-primary:hover {
		background: var(--color-primary-dark);
		transform: translateY(-1px);
		box-shadow: 0 4px 12px rgba(14, 165, 233, 0.3);
	}

	.btn-secondary {
		background: var(--color-bg-secondary);
		color: var(--color-text);
		border: 1px solid var(--color-border);
	}

	.btn-secondary:hover {
		background: var(--color-bg-tertiary);
		transform: translateY(-1px);
		border-color: var(--color-primary);
	}

	.btn-tertiary {
		background: transparent;
		color: var(--color-text-secondary);
		border: 1px solid var(--color-border);
	}

	.btn-tertiary:hover {
		color: var(--color-text);
		border-color: var(--color-primary);
		transform: translateY(-1px);
	}

	.hero-avatar {
		position: relative;
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.avatar-wrapper {
		position: relative;
		width: 280px;
		height: 280px;
	}

	.avatar {
		width: 280px;
		height: 280px;
		border-radius: 50%;
		object-fit: cover;
		position: relative;
		z-index: 2;
		transition: all var(--transition);
	}

	.avatar-border {
		position: absolute;
		top: -8px;
		left: -8px;
		right: -8px;
		bottom: -8px;
		border-radius: 50%;
		background: linear-gradient(135deg, var(--color-primary), var(--color-accent-cyan));
		z-index: 1;
		opacity: 0.3;
		animation: rotate 20s linear infinite;
	}

	@keyframes rotate {
		from { transform: rotate(0deg); }
		to { transform: rotate(360deg); }
	}

	.floating-icons {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		pointer-events: none;
	}

	.floating-icon {
		position: absolute;
		font-size: 2rem;
		opacity: 0.6;
		animation: float 6s ease-in-out infinite;
	}

	.icon-aws {
		top: -20px;
		left: 50%;
		transform: translateX(-50%);
		animation-delay: 0s;
	}

	.icon-docker {
		bottom: -20px;
		left: -20px;
		animation-delay: 2s;
	}

	.icon-k8s {
		bottom: -20px;
		right: -20px;
		animation-delay: 4s;
	}

	@keyframes float {
		0%, 100% { transform: translateY(0) translateX(0); }
		50% { transform: translateY(-20px) translateX(10px); }
	}

	@keyframes shine {
		0% { left: -100%; }
		100% { left: 100%; }
	}

	/* Achievements Section */
	.achievements-section {
		margin-bottom: var(--space-16);
	}

	.achievements-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: var(--space-6);
		margin-top: var(--space-8);
	}

	.achievement-card {
		padding: var(--space-6);
		background: var(--color-bg-secondary);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-xl);
		text-align: center;
		transition: all var(--transition-fast);
		position: relative;
		overflow: hidden;
	}

	.achievement-card:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: 2px;
	}

	.achievement-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 4px;
		background: linear-gradient(90deg, var(--color-primary), var(--color-accent-cyan));
		opacity: 0;
		transition: opacity var(--transition-fast);
	}

	.achievement-card:hover {
		transform: translateY(-4px);
		border-color: var(--color-primary);
		box-shadow: 0 8px 24px rgba(14, 165, 233, 0.15);
	}

	.achievement-card:hover::before {
		opacity: 1;
	}

	.achievement-icon {
		font-size: 3rem;
		margin-bottom: var(--space-4);
		display: block;
	}

	.achievement-title {
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--color-text);
		margin-bottom: var(--space-2);
	}

	.achievement-subtitle {
		font-size: 1rem;
		font-weight: 600;
		color: var(--color-primary);
		margin-bottom: var(--space-2);
	}

	.achievement-description {
		font-size: 0.875rem;
		color: var(--color-text-secondary);
		line-height: 1.6;
		margin: 0;
	}

	.achievement-location {
		font-size: 0.8125rem;
		color: var(--color-text-secondary);
		opacity: 0.85;
		margin: var(--space-1) 0 0;
	}

	/* Content Sections */
	.content-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-12);
	}

	.content-section {
		margin-bottom: var(--space-8);
	}

	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: var(--space-6);
	}

	.section-title {
		font-size: 1.875rem;
		font-weight: 700;
		color: var(--color-text);
	}

	.section-subtitle {
		font-size: 1rem;
		color: var(--color-text-secondary);
		margin-bottom: var(--space-6);
	}

	.see-all {
		color: var(--color-text-secondary);
		text-decoration: none;
		font-size: 0.875rem;
		font-weight: 500;
		transition: color var(--transition-fast);
	}

	.see-all:hover {
		color: var(--color-primary);
	}

	/* Post Cards */
	.post-list {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.post-card {
		display: block;
		text-decoration: none;
		padding: var(--space-4);
		border-radius: var(--radius-lg);
		transition: all var(--transition-fast);
		border: 1px solid transparent;
	}

	.post-card:hover {
		background: var(--color-bg-secondary);
		border-color: var(--color-border);
		transform: translateY(-2px);
	}

	.post-title {
		font-size: 1.125rem;
		font-weight: 600;
		color: var(--color-primary);
		margin-bottom: var(--space-2);
		line-height: 1.4;
	}

	.post-date {
		font-size: 0.875rem;
		color: var(--color-text-secondary);
		margin-bottom: var(--space-2);
	}

	.post-description {
		font-size: 0.875rem;
		color: var(--color-text-secondary);
		line-height: 1.5;
		margin-bottom: var(--space-3);
	}

	.post-tags {
		display: flex;
		gap: var(--space-2);
		flex-wrap: wrap;
	}

	.tag {
		background: var(--color-bg-tertiary);
		color: var(--color-text-secondary);
		padding: var(--space-1) var(--space-2);
		border-radius: var(--radius);
		font-size: 0.75rem;
		font-weight: 500;
	}

	/* Project Cards */
	.project-card {
		position: relative;
		overflow: hidden;
	}

	.project-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		background: linear-gradient(90deg, var(--color-primary), var(--color-accent-cyan));
		opacity: 0;
		transition: opacity var(--transition-fast);
	}

	.project-card:hover::before {
		opacity: 1;
	}

	.project-card .project-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: var(--space-3);
		margin-bottom: var(--space-3);
	}

	.project-card-footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-top: var(--space-3);
		padding-top: var(--space-3);
		border-top: 1px solid var(--color-border);
	}

	.project-links {
		display: flex;
		gap: var(--space-2);
	}

	.project-link-icon {
		font-size: 1.125rem;
		text-decoration: none;
		opacity: 0.7;
		transition: all var(--transition-fast);
		display: inline-block;
	}

	.project-link-icon:hover {
		opacity: 1;
