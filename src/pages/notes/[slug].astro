---
import { getCollection, getEntry } from 'astro:content';
import readingTime from 'reading-time';
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import ArticleLayout from '../../components/content/ArticleLayout.astro';
import { SITE } from '../../config/site';

export async function getStaticPaths() {
    const notes = await getCollection('notes', ({ data }) => !data.draft);
    return notes.map((n) => ({ params: { slug: n.slug } }));
}

const { slug } = Astro.params;
const note = await getEntry('notes', slug);
if (!note) { throw new Error(`Note not found: ${slug}`); }
const { data } = note;
const { Content, headings } = await note.render();
const readStats = readingTime(note.body);
const noteUrl = new URL(`/notes/${slug}/`, SITE.url).href;

const articleSchema = {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: data.title,
    description: data.description,
    datePublished: data.publishDate.toISOString(),
    author: {
        '@type': 'Person',
        name: SITE.name,
        url: SITE.url,
    },
    url: noteUrl,
};
---

<PortfolioLayout title={data.title} description={data.description} type="article">
    <Fragment slot="head">
        <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    </Fragment>
    <ArticleLayout
        backHref="/notes"
        backLabel="Back to Notes"
        title={data.title}
        description={data.description}
        publishDate={data.publishDate}
        tags={data.tags}
        readStats={readStats}
        headings={headings}
        shareUrl={noteUrl}
    >
        <Content />
    </ArticleLayout>
</PortfolioLayout>
