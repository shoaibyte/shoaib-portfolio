---
import { getCollection } from 'astro:content';
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import { formatDate } from '../../utils/formatDate';

export async function getStaticPaths() {
    const posts = await getCollection('blog', ({ data }) => !data.draft);
    const tagSet = new Set<string>();
    posts.forEach((post) => post.data.tags.forEach((tag) => tagSet.add(tag)));
    return [...tagSet].map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const decodedTag = decodeURIComponent(tag!);

const posts = (await getCollection('blog', ({ data }) =>
    !data.draft && data.tags.includes(decodedTag),
)).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<PortfolioLayout title={`Posts tagged "${decodedTag}"`} description={`Blog posts tagged with ${decodedTag}.`}>
    <section class="tag-page">
        <header class="page-header">
            <a href="/blog" class="back-link">&larr; Back to Blog</a>
            <h1 class="page-title">Tag: {decodedTag}</h1>
            <p class="page-subtitle">{posts.length} post{posts.length === 1 ? '' : 's'} found</p>
        </header>

        <div class="grid">
            {posts.map(({ data, slug }) => (
                <article class="card">
                    <a href={`/blog/${slug}/`} class="card-link">
                        <h2 class="card-title">{data.title}</h2>
                        <p class="card-desc">{data.description}</p>
                        <time datetime={data.publishDate.toISOString()}>{formatDate(data.publishDate)}</time>
                    </a>
                </article>
            ))}
        </div>
    </section>
</PortfolioLayout>

<style>
    .back-link {
        display: inline-block;
        color: var(--color-text-secondary);
        text-decoration: none;
        font-size: 0.875rem;
        margin-bottom: var(--space-4);
    }

    .back-link:hover {
        color: var(--color-primary);
    }

    .page-title {
        font-size: 2rem;
        font-weight: 800;
        margin: 0 0 var(--space-2);
    }

    .page-subtitle {
        color: var(--color-text-secondary);
        margin: 0 0 var(--space-8);
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 480px), 1fr));
        gap: var(--space-6);
    }

    .card {
        padding: var(--space-6);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-xl);
        background: var(--color-bg-secondary);
        transition: all var(--transition-fast);
    }

    .card:hover {
        border-color: var(--color-primary);
        transform: translateY(-2px);
    }

    .card-link {
        text-decoration: none;
        color: inherit;
    }

    .card-title {
        font-size: 1.125rem;
        font-weight: 700;
        margin: 0 0 var(--space-2);
        color: var(--color-primary);
    }

    .card-desc {
        color: var(--color-text-secondary);
        font-size: 0.875rem;
        margin: 0 0 var(--space-3);
    }

    time {
        font-size: 0.8125rem;
        color: var(--color-text-secondary);
        font-family: var(--font-mono);
    }
</style>
