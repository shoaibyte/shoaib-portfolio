---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import { SOCIAL_LINKS, SITE } from '../config/site';
---
<PortfolioLayout title="About" description="About Shoaib Hasan — Backend Engineer specializing in Go, distributed systems, auth, billing, and observability at scale.">
    <article class="about-page">
        <!-- Introduction Section -->
        <section class="about-section">
            <h1>Hey, I'm Shoaib 👋</h1>
            <div class="intro-content">
                <p class="intro-text">
                    I'm <strong>Shoaib Hasan</strong>, a Backend Engineer from
                    <strong>Dhaka, Bangladesh 🇧🇩</strong>. I build Go-first distributed systems with
                    a focus on authentication, billing, and observability — currently serving 30K+
                    concurrent users on AWS at Placepoint.
                </p>
                <p class="intro-text">
                    With 4+ years of experience, I design event-driven microservices, REST and gRPC APIs,
                    and production infrastructure on AWS ECS, Lambda, Docker, and Kubernetes. I also work
                    with TypeScript/Node.js and integrate AI-assisted development tools into my workflow.
                </p>
            </div>
        </section>

        <!-- Current Focus Section -->
        <section class="about-section">
            <h2>Current Focus</h2>
            <div class="focus-card">
                <div class="focus-icon">🎯</div>
                <div class="focus-content">
                    <h3>Backend Engineer at Placepoint</h3>
                    <p>Building event-driven payment and billing systems with Kafka, PostgreSQL, and Redis. Leading auth, billing, and observability initiatives — including a billing platform that generated $500K in revenue.</p>
                </div>
            </div>
        </section>

        <!-- Work Experience -->
        <section class="about-section">
            <h2>Work Experience</h2>
            <div class="timeline">
                <div class="timeline-item">
                    <div class="timeline-marker">💼</div>
                    <div class="timeline-content">
                        <h3>Backend Engineer — Placepoint</h3>
                        <p class="timeline-date">Jun 2023 – Present · Dhaka</p>
                        <p>Formerly PropCloud / Softwrd Ltd (acquired Dec 2024). Built event-driven payment platform, auth systems, and observability stack serving 30K+ users.</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-marker">💼</div>
                    <div class="timeline-content">
                        <h3>Software Engineer — Gorillamove</h3>
                        <p class="timeline-date">Feb – May 2023</p>
                        <p>Developed backend services and APIs for logistics platform operations.</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-marker">💼</div>
                    <div class="timeline-content">
                        <h3>Junior Software Engineer — Poridhi</h3>
                        <p class="timeline-date">Jul 2022 – Jan 2023</p>
                        <p>Contributed to backend development and cloud infrastructure for early-stage products.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Achievements Timeline -->
        <section class="about-section">
            <h2>Achievements & Recognition</h2>
            <div class="timeline">
                <div class="timeline-item">
                    <div class="timeline-marker">🌟</div>
                    <div class="timeline-content">
                        <h3>Excellence Award for Technical Brilliance</h3>
                        <p class="timeline-date">2025 · Placepoint</p>
                        <p>Recognized for outstanding technical contributions to the payment and billing platform</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-marker">🏆</div>
                    <div class="timeline-content">
                        <h3>IBCOL 2023 — 6th Place International</h3>
                        <p class="timeline-date">2023 · Amsterdam, Netherlands</p>
                        <p>International Blockchain Olympiad — award winner for innovative blockchain solution</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-marker">💰</div>
                    <div class="timeline-content">
                        <h3>$500K Billing Platform Revenue</h3>
                        <p class="timeline-date">2023–2025</p>
                        <p>Event-driven payment platform generating significant revenue through infrastructure and product improvements</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-marker">⚡</div>
                    <div class="timeline-content">
                        <h3>Performance & Reliability</h3>
                        <p class="timeline-date">Ongoing</p>
                        <p>99.9% system uptime, 30% latency reduction, scalable architecture design</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Education -->
        <section class="about-section">
            <h2>Education</h2>
            <div class="focus-card">
                <div class="focus-icon">🎓</div>
                <div class="focus-content">
                    <h3>B.S. Computer Science & Engineering</h3>
                    <p class="timeline-date">United International University · Jan 2019 – 2024</p>
                    <p>Expected completion: June 2026</p>
                </div>
            </div>
        </section>

        <!-- Expertise Section -->
        <section class="about-section">
            <h2>Expertise & Skills</h2>
            <div class="expertise-grid">
                <div class="expertise-category">
                    <h3>Backend Development</h3>
                    <ul class="skill-list">
                        <li>Go (Golang) — primary</li>
                        <li>TypeScript & Node.js</li>
                        <li>Java & Python</li>
                        <li>REST & gRPC APIs</li>
                        <li>Auth, Billing & OpenAPI</li>
                    </ul>
                </div>
                <div class="expertise-category">
                    <h3>Infrastructure & DevOps</h3>
                    <ul class="skill-list">
                        <li>AWS ECS & Lambda</li>
                        <li>Docker & Kubernetes</li>
                        <li>Terraform</li>
                        <li>CI/CD & TDD</li>
                        <li>Prometheus, Grafana & ELK</li>
                    </ul>
                </div>
                <div class="expertise-category">
                    <h3>Data & Messaging</h3>
                    <ul class="skill-list">
                        <li>PostgreSQL & Redis</li>
                        <li>MongoDB & Neo4j</li>
                        <li>Kafka & RabbitMQ</li>
                        <li>AWS SQS</li>
                        <li>Event-Driven Architecture</li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- What I'm Building -->
        <section class="about-section">
            <h2>What I'm Building</h2>
            <div class="building-grid">
                <div class="building-item">
                    <div class="building-icon">💳</div>
                    <h3>Event-Driven Payment Platform</h3>
                    <p>Kafka-based billing system with $500K revenue impact at Placepoint</p>
                </div>
                <div class="building-item">
                    <div class="building-icon">🔐</div>
                    <h3>Auth & Billing Systems</h3>
                    <p>Secure authentication and subscription billing for 30K+ users</p>
                </div>
                <div class="building-item">
                    <div class="building-icon">📊</div>
                    <h3>Observability Stack</h3>
                    <p>Prometheus, Grafana, and ELK for production monitoring at scale</p>
                </div>
                <div class="building-item">
                    <div class="building-icon">🤖</div>
                    <h3>AI-Assisted Development</h3>
                    <p>Integrating Claude Code, Cursor, and LLM tooling into engineering workflows</p>
                </div>
            </div>
        </section>

        <!-- Connect Section -->
        <section class="about-section">
            <h2>Let's Connect & Collaborate</h2>
            <p class="connect-intro">
                Open to collaborate on backend development, event-driven architectures,
                cloud infrastructure, and observability at scale.
            </p>
            <div class="connect-links">
                <a href={SOCIAL_LINKS.email} class="connect-link">
                    <span>📧</span>
                    <div>
                        <strong>Email</strong>
                        <span>shoaib.hasan1801@gmail.com</span>
                    </div>
                </a>
                <a href={`tel:${SITE.phone.replace(/\s/g, '')}`} class="connect-link">
                    <span>📱</span>
                    <div>
                        <strong>Phone</strong>
                        <span>{SITE.phone}</span>
                    </div>
                </a>
                <a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer" class="connect-link">
                    <span>💼</span>
                    <div>
                        <strong>LinkedIn</strong>
                        <span>Connect on LinkedIn</span>
                    </div>
                </a>
                <a href={SOCIAL_LINKS.medium} target="_blank" rel="noopener noreferrer" class="connect-link">
                    <span>✍️</span>
                    <div>
                        <strong>Medium</strong>
                        <span>Read my articles</span>
                    </div>
                </a>
                <a href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer" class="connect-link">
                    <span>🐙</span>
                    <div>
                        <strong>GitHub</strong>
                        <span>View my code</span>
                    </div>
                </a>
            </div>
        </section>
    </article>
</PortfolioLayout>

<style>
    .about-page {
        max-width: 900px;
        margin: 0 auto;
    }

    .about-section {
        margin-bottom: var(--space-12);
    }

    .about-section h1 {
        font-size: 3rem;
        font-weight: 800;
        color: var(--color-text);
        margin-bottom: var(--space-6);
        line-height: 1.1;
    }

    .about-section h2 {
        font-size: 2rem;
        font-weight: 700;
        color: var(--color-text);
        margin-bottom: var(--space-6);
        padding-bottom: var(--space-3);
        border-bottom: 2px solid var(--color-border);
    }

    .intro-content {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
    }

    .intro-text {
        font-size: 1.125rem;
        line-height: 1.7;
        color: var(--color-text-secondary);
    }

    .focus-card {
        display: flex;
        gap: var(--space-4);
        padding: var(--space-6);
        background: var(--color-bg-secondary);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-xl);
        border-left: 4px solid var(--color-primary);
    }

    .focus-icon {
        font-size: 3rem;
        flex-shrink: 0;
    }

    .focus-content h3 {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--color-text);
        margin-bottom: var(--space-2);
    }

    .focus-content p {
        color: var(--color-text-secondary);
        line-height: 1.6;
    }

    .timeline {
        position: relative;
        padding-left: var(--space-8);
    }

    .timeline::before {
        content: '';
        position: absolute;
        left: 15px;
        top: 0;
        bottom: 0;
        width: 2px;
        background: var(--color-border);
    }

    .timeline-item {
        position: relative;
        margin-bottom: var(--space-8);
        padding-left: var(--space-8);
    }

    .timeline-marker {
        position: absolute;
        left: -32px;
        top: 0;
        width: 32px;
        height: 32px;
        background: var(--color-bg);
        border: 3px solid var(--color-primary);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        z-index: 1;
    }

    .timeline-content h3 {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--color-text);
        margin-bottom: var(--space-1);
    }

    .timeline-date {
        font-size: 0.875rem;
        color: var(--color-primary);
        font-weight: 600;
        margin-bottom: var(--space-2);
        font-family: var(--font-mono);
    }

    .timeline-content p {
        color: var(--color-text-secondary);
        line-height: 1.6;
    }

    .expertise-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--space-6);
    }

    .expertise-category {
        padding: var(--space-6);
        background: var(--color-bg-secondary);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-xl);
    }

    .expertise-category h3 {
        font-size: 1.125rem;
        font-weight: 700;
        color: var(--color-text);
        margin-bottom: var(--space-4);
        padding-bottom: var(--space-2);
        border-bottom: 1px solid var(--color-border);
    }

    .skill-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
    }

    .skill-list li {
        color: var(--color-text-secondary);
        font-size: 0.9375rem;
        padding-left: var(--space-4);
        position: relative;
    }

    .skill-list li::before {
        content: '▹';
        position: absolute;
        left: 0;
        color: var(--color-primary);
    }

    .building-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--space-6);
    }

    .building-item {
        padding: var(--space-6);
        background: var(--color-bg-secondary);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-xl);
        text-align: center;
        transition: all var(--transition-fast);
    }

    .building-item:hover {
        transform: translateY(-4px);
        border-color: var(--color-primary);
        box-shadow: 0 8px 24px rgba(14, 165, 233, 0.15);
    }

    .building-icon {
        font-size: 2.5rem;
        margin-bottom: var(--space-4);
    }

    .building-item h3 {
        font-size: 1.125rem;
        font-weight: 700;
        color: var(--color-text);
        margin-bottom: var(--space-2);
    }

    .building-item p {
        color: var(--color-text-secondary);
        font-size: 0.875rem;
        line-height: 1.6;
    }

    .connect-intro {
        color: var(--color-text-secondary);
        line-height: 1.7;
        margin-bottom: var(--space-6);
    }

    .connect-links {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--space-4);
    }

    .connect-link {
        display: flex;
        align-items: center;
        gap: var(--space-4);
        padding: var(--space-4);
        background: var(--color-bg-secondary);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        text-decoration: none;
        transition: all var(--transition-fast);
    }

    .connect-link:hover {
        transform: translateY(-2px);
        border-color: var(--color-primary);
        box-shadow: 0 4px 12px rgba(14, 165, 233, 0.15);
    }

    .connect-link span:first-child {
        font-size: 1.5rem;
        flex-shrink: 0;
    }

    .connect-link div {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
    }

    .connect-link strong {
        color: var(--color-text);
        font-size: 0.9375rem;
        font-weight: 600;
    }

    .connect-link span:last-child {
        color: var(--color-text-secondary);
        font-size: 0.875rem;
    }

    @media (max-width: 768px) {
        .about-section h1 {
            font-size: 2.25rem;
        }

        .about-section h2 {
            font-size: 1.5rem;
        }

        .expertise-grid {
            grid-template-columns: 1fr;
        }

        .building-grid {
            grid-template-columns: 1fr;
        }

        .connect-links {
            grid-template-columns: 1fr;
        }

        .timeline {
            padding-left: var(--space-6);
        }

        .timeline-item {
            padding-left: var(--space-6);
        }

        .timeline-marker {
            left: -24px;
            width: 24px;
            height: 24px;
        }
    }
</style>
