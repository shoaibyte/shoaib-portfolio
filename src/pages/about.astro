---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
---
<PortfolioLayout title="About" description="About Shoaib Hasan - Backend Architect, Distributed Systems Expert, and Open Source Enthusiast.">
    <article class="about-page">
        <!-- Introduction Section -->
        <section class="about-section">
            <h1>Hey, I'm Shoaib 👋</h1>
            <div class="intro-content">
                <p class="intro-text">
                    I'm <strong>Shoaib Hasan</strong>, a Software Engineer & Open Source Enthusiast from 
                    <strong>Dhaka, Bangladesh 🇧🇩</strong>. I specialize in building scalable distributed systems 
                    and cloud architectures that power millions of users.
                </p>
                <p class="intro-text">
                    Passionate about <strong>Distributed Systems</strong>, <strong>Cloud Architecture</strong>, 
                    and <strong>Blockchain</strong> technology. I've been building scalable microservices since 2022, 
                    focusing on performance, reliability, and scalability.
                </p>
            </div>
        </section>

        <!-- Current Focus Section -->
        <section class="about-section">
            <h2>Current Focus</h2>
            <div class="focus-card">
                <div class="focus-icon">🎯</div>
                <div class="focus-content">
                    <h3>Building Scalable Microservices</h3>
                    <p>Currently building distributed microservices that handle 30K+ users, real-time payment processing systems, and blockchain-based transparency solutions.</p>
                </div>
            </div>
        </section>

        <!-- Achievements Timeline -->
        <section class="about-section">
            <h2>Achievements & Recognition</h2>
            <div class="timeline">
                <div class="timeline-item">
                    <div class="timeline-marker">🏆</div>
                    <div class="timeline-content">
                        <h3>IBCOL 2023 - 6th Place International</h3>
                        <p class="timeline-date">2023 • Amsterdam, Netherlands</p>
                        <p>International Blockchain Olympiad - Award winner for innovative blockchain solution</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-marker">💰</div>
                    <div class="timeline-content">
                        <h3>$200K+ Revenue Impact</h3>
                        <p class="timeline-date">2023-2024</p>
                        <p>Platform revenue generated through infrastructure improvements and optimizations</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-marker">⚡</div>
                    <div class="timeline-content">
                        <h3>Performance Expert</h3>
                        <p class="timeline-date">Ongoing</p>
                        <p>99.9% system uptime, 30% latency reduction, scalable architecture design</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Expertise Section -->
        <section class="about-section">
            <h2>Expertise & Skills</h2>
            <div class="expertise-grid">
                <div class="expertise-category">
                    <h3>Backend Development</h3>
                    <ul class="skill-list">
                        <li>Java & Spring Framework</li>
                        <li>Go (Golang)</li>
                        <li>Python & FastAPI</li>
                        <li>Microservices Architecture</li>
                        <li>REST & GraphQL APIs</li>
                    </ul>
                </div>
                <div class="expertise-category">
                    <h3>Infrastructure & DevOps</h3>
                    <ul class="skill-list">
                        <li>AWS Cloud Services</li>
                        <li>Docker & Kubernetes</li>
                        <li>Terraform</li>
                        <li>CI/CD Pipelines</li>
                        <li>Monitoring & Observability</li>
                    </ul>
                </div>
                <div class="expertise-category">
                    <h3>Databases & Data</h3>
                    <ul class="skill-list">
                        <li>PostgreSQL</li>
                        <li>MongoDB</li>
                        <li>Redis</li>
                        <li>Kafka</li>
                        <li>Data Modeling</li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- What I'm Building -->
        <section class="about-section">
            <h2>What I'm Building</h2>
            <div class="building-grid">
                <div class="building-item">
                    <div class="building-icon">🌐</div>
                    <h3>Distributed Microservices</h3>
                    <p>Handling 30K+ users with high availability and scalability</p>
                </div>
                <div class="building-item">
                    <div class="building-icon">⚡</div>
                    <h3>Real-time Payment Systems</h3>
                    <p>Processing payments with low latency and high reliability</p>
                </div>
                <div class="building-item">
                    <div class="building-icon">🔐</div>
                    <h3>Blockchain Solutions</h3>
                    <p>Transparency and trust through decentralized systems</p>
                </div>
                <div class="building-item">
                    <div class="building-icon">📊</div>
                    <h3>Data Processing Pipelines</h3>
                    <p>High-performance pipelines for real-time analytics</p>
                </div>
            </div>
        </section>

        <!-- Connect Section -->
        <section class="about-section">
            <h2>Let's Connect & Collaborate</h2>
            <p class="connect-intro">
                Open to collaborate on backend development, scalable microservices architecture, 
                DevOps and cloud infrastructure, and decentralized applications (DApps).
            </p>
            <div class="connect-links">
                <a href="mailto:shoaib.hasan1801@gmail.com" class="connect-link">
                    <span>📧</span>
                    <div>
                        <strong>Email</strong>
                        <span>shoaib.hasan1801@gmail.com</span>
                    </div>
                </a>
                <a href="https://www.linkedin.com/in/shoaib-hasan-568528210/" target="_blank" rel="noopener noreferrer" class="connect-link">
                    <span>💼</span>
                    <div>
                        <strong>LinkedIn</strong>
                        <span>Connect on LinkedIn</span>
                    </div>
                </a>
                <a href="https://shoaib-hasan1801.medium.com" target="_blank" rel="noopener noreferrer" class="connect-link">
                    <span>✍️</span>
                    <div>
                        <strong>Medium</strong>
                        <span>Read my articles</span>
                    </div>
                </a>
                <a href="https://github.com/sayanshoaib" target="_blank" rel="noopener noreferrer" class="connect-link">
                    <span>🐙</span>
                    <div>
                        <strong>GitHub</strong>
                        <span>View my code</span>
                    </div>
                </a>
            </div>
        </section>
    </article>
</PortfolioLayout>

<style>
    .about-page {
        max-width: 900px;
        margin: 0 auto;
    }

    .about-section {
        margin-bottom: var(--space-12);
    }

    .about-section h1 {
        font-size: 3rem;
        font-weight: 800;
        color: var(--color-text);
        margin-bottom: var(--space-6);
        line-height: 1.1;
    }

    .about-section h2 {
        font-size: 2rem;
        font-weight: 700;
        color: var(--color-text);
        margin-bottom: var(--space-6);
        padding-bottom: var(--space-3);
        border-bottom: 2px solid var(--color-border);
    }

    .intro-content {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
    }

    .intro-text {
        font-size: 1.125rem;
        line-height: 1.7;
        color: var(--color-text-secondary);
    }

    .focus-card {
        display: flex;
        gap: var(--space-4);
        padding: var(--space-6);
        background: var(--color-bg-secondary);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-xl);
        border-left: 4px solid var(--color-primary);
    }

    .focus-icon {
        font-size: 3rem;
        flex-shrink: 0;
    }

    .focus-content h3 {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--color-text);
        margin-bottom: var(--space-2);
    }

    .focus-content p {
        color: var(--color-text-secondary);
        line-height: 1.6;
    }

    .timeline {
        position: relative;
        padding-left: var(--space-8);
    }

    .timeline::before {
        content: '';
        position: absolute;
        left: 15px;
        top: 0;
        bottom: 0;
        width: 2px;
        background: var(--color-border);
    }

    .timeline-item {
        position: relative;
        margin-bottom: var(--space-8);
        padding-left: var(--space-8);
    }

    .timeline-marker {
        position: absolute;
        left: -32px;
        top: 0;
        width: 32px;
        height: 32px;
        background: var(--color-bg);
        border: 3px solid var(--color-primary);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        z-index: 1;
    }

    .timeline-content h3 {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--color-text);
        margin-bottom: var(--space-1);
    }

    .timeline-date {
        font-size: 0.875rem;
        color: var(--color-primary);
        font-weight: 600;
        margin-bottom: var(--space-2);
        font-family: var(--font-mono);
    }

    .timeline-content p {
        color: var(--color-text-secondary);
        line-height: 1.6;
    }

    .expertise-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--space-6);
    }

    .expertise-category {
        padding: var(--space-6);
        background: var(--color-bg-secondary);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-xl);
    }

    .expertise-category h3 {
        font-size: 1.125rem;
        font-weight: 700;
        color: var(--color-text);
        margin-bottom: var(--space-4);
        padding-bottom: var(--space-2);
        border-bottom: 1px solid var(--color-border);
    }

    .skill-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
    }

    .skill-list li {
        color: var(--color-text-secondary);
        font-size: 0.9375rem;
        padding-left: var(--space-4);
        position: relative;
    }

    .skill-list li::before {
        content: '▹';
        position: absolute;
        left: 0;
        color: var(--color-primary);
    }

    .building-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--space-6);
    }

    .building-item {
        padding: var(--space-6);
        background: var(--color-bg-secondary);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-xl);
        text-align: center;
        transition: all var(--transition-fast);
    }

    .building-item:hover {
        transform: translateY(-4px);
        border-color: var(--color-primary);
        box-shadow: 0 8px 24px rgba(14, 165, 233, 0.15);
    }

    .building-icon {
        font-size: 2.5rem;
        margin-bottom: var(--space-4);
    }

    .building-item h3 {
        font-size: 1.125rem;
        font-weight: 700;
        color: var(--color-text);
        margin-bottom: var(--space-2);
    }

    .building-item p {
        color: var(--color-text-secondary);
        font-size: 0.875rem;
        line-height: 1.6;
    }

    .connect-intro {
        color: var(--color-text-secondary);
        line-height: 1.7;
        margin-bottom: var(--space-6);
    }

    .connect-links {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--space-4);
    }

    .connect-link {
        display: flex;
        align-items: center;
        gap: var(--space-4);
        padding: var(--space-4);
        background: var(--color-bg-secondary);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        text-decoration: none;
        transition: all var(--transition-fast);
    }

    .connect-link:hover {
        transform: translateY(-2px);
        border-color: var(--color-primary);
        box-shadow: 0 4px 12px rgba(14, 165, 233, 0.15);
    }

    .connect-link span:first-child {
        font-size: 1.5rem;
        flex-shrink: 0;
    }

    .connect-link div {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
    }

    .connect-link strong {
        color: var(--color-text);
        font-size: 0.9375rem;
        font-weight: 600;
    }

    .connect-link span:last-child {
        color: var(--color-text-secondary);
        font-size: 0.875rem;
    }

    @media (max-width: 768px) {
        .about-section h1 {
            font-size: 2.25rem;
        }

        .about-section h2 {
            font-size: 1.5rem;
        }

        .expertise-grid {
            grid-template-columns: 1fr;
        }

        .building-grid {
            grid-template-columns: 1fr;
        }

        .connect-links {
            grid-template-columns: 1fr;
        }

        .timeline {
            padding-left: var(--space-6);
        }

        .timeline-item {
            padding-left: var(--space-6);
        }

        .timeline-marker {
            left: -24px;
            width: 24px;
            height: 24px;
        }
    }
</style>
