---
// src/components/layout/Footer.astro
import { SITE, SOCIAL_LINKS } from '../../config/site';

const year = new Date().getFullYear();
---

<footer class="footer" role="contentinfo" aria-label="Site footer">
    <div class="footer-inner">
        <p class="footer-copy">&copy; {year} {SITE.name}. All rights reserved.</p>
        <nav class="footer-nav" aria-label="Footer navigation">
            <a href="/">Home</a>
            <a href="/blog">Blog</a>
            <a href="/projects">Projects</a>
            <a href="/notes">Notes</a>
            <a href="/about">About</a>
        </nav>
        <div class="footer-social">
            <a href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">GitHub</a>
            <a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">LinkedIn</a>
            <a href={SOCIAL_LINKS.twitter} target="_blank" rel="noopener noreferrer" aria-label="Twitter">Twitter</a>
        </div>
    </div>
</footer>

<style>
    .footer {
        margin-top: var(--space-16);
        padding: var(--space-8) 0;
        border-top: 1px solid var(--color-border);
    }

    .footer-inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        max-width: 1200px;
        margin: 0 auto;
    }

    .footer-copy {
        font-size: 0.875rem;
        color: var(--color-text-secondary);
        margin: 0;
    }

    .footer-nav {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-4);
    }

    .footer-nav a {
        font-size: 0.875rem;
        color: var(--color-text-secondary);
        text-decoration: none;
        transition: color var(--transition-fast);
    }

    .footer-nav a:hover {
        color: var(--color-primary);
    }

    .footer-social {
        display: flex;
        gap: var(--space-4);
    }

    .footer-social a {
        font-size: 0.875rem;
        color: var(--color-text-secondary);
        text-decoration: none;
        transition: color var(--transition-fast);
    }

    .footer-social a:hover {
        color: var(--color-primary);
    }

    @media (max-width: 768px) {
        .footer-inner {
            flex-direction: column;
            text-align: center;
        }
    }
</style>
