---
// src/components/common/TechStack.astro
---

<section class="tech-stack-section">
	<h2 class="section-title">Tech Arsenal</h2>
	<p class="section-subtitle">Technologies I work with to build scalable systems</p>

	<div class="tech-categories">
		<!-- Languages & Frameworks -->
		<div class="tech-category">
			<h3 class="category-title">Languages & Frameworks</h3>
			<div class="tech-grid">
				<div class="tech-item" data-tech="Java">
					<img src="https://skillicons.dev/icons?i=java" alt="Java" class="tech-icon" loading="lazy" />
					<span class="tech-name">Java</span>
				</div>
				<div class="tech-item" data-tech="Go">
					<img src="https://skillicons.dev/icons?i=go" alt="Go" class="tech-icon" loading="lazy" />
					<span class="tech-name">Go</span>
				</div>
				<div class="tech-item" data-tech="Python">
					<img src="https://skillicons.dev/icons?i=python" alt="Python" class="tech-icon" loading="lazy" />
					<span class="tech-name">Python</span>
				</div>
				<div class="tech-item" data-tech="Spring">
					<img src="https://skillicons.dev/icons?i=spring" alt="Spring" class="tech-icon" loading="lazy" />
					<span class="tech-name">Spring</span>
				</div>
				<div class="tech-item" data-tech="FastAPI">
					<img src="https://skillicons.dev/icons?i=fastapi" alt="FastAPI" class="tech-icon" loading="lazy" />
					<span class="tech-name">FastAPI</span>
				</div>
			</div>
		</div>

		<!-- Databases & Cloud -->
		<div class="tech-category">
			<h3 class="category-title">Databases & Cloud</h3>
			<div class="tech-grid">
				<div class="tech-item" data-tech="PostgreSQL">
					<img src="https://skillicons.dev/icons?i=postgresql" alt="PostgreSQL" class="tech-icon" loading="lazy" />
					<span class="tech-name">PostgreSQL</span>
				</div>
				<div class="tech-item" data-tech="MongoDB">
					<img src="https://skillicons.dev/icons?i=mongodb" alt="MongoDB" class="tech-icon" loading="lazy" />
					<span class="tech-name">MongoDB</span>
				</div>
				<div class="tech-item" data-tech="Redis">
					<img src="https://skillicons.dev/icons?i=redis" alt="Redis" class="tech-icon" loading="lazy" />
					<span class="tech-name">Redis</span>
				</div>
				<div class="tech-item" data-tech="AWS">
					<img src="https://skillicons.dev/icons?i=aws" alt="AWS" class="tech-icon" loading="lazy" />
					<span class="tech-name">AWS</span>
				</div>
				<div class="tech-item" data-tech="Docker">
					<img src="https://skillicons.dev/icons?i=docker" alt="Docker" class="tech-icon" loading="lazy" />
					<span class="tech-name">Docker</span>
				</div>
				<div class="tech-item" data-tech="Kubernetes">
					<img src="https://skillicons.dev/icons?i=kubernetes" alt="Kubernetes" class="tech-icon" loading="lazy" />
					<span class="tech-name">Kubernetes</span>
				</div>
			</div>
		</div>

		<!-- Tools & Technologies -->
		<div class="tech-category">
			<h3 class="category-title">Tools & Technologies</h3>
			<div class="tech-grid">
				<div class="tech-item" data-tech="Kafka">
					<img src="https://skillicons.dev/icons?i=kafka" alt="Kafka" class="tech-icon" loading="lazy" />
					<span class="tech-name">Kafka</span>
				</div>
				<div class="tech-item" data-tech="Nginx">
					<img src="https://skillicons.dev/icons?i=nginx" alt="Nginx" class="tech-icon" loading="lazy" />
					<span class="tech-name">Nginx</span>
				</div>
				<div class="tech-item" data-tech="Terraform">
					<img src="https://skillicons.dev/icons?i=terraform" alt="Terraform" class="tech-icon" loading="lazy" />
					<span class="tech-name">Terraform</span>
				</div>
				<div class="tech-item" data-tech="Linux">
					<img src="https://skillicons.dev/icons?i=linux" alt="Linux" class="tech-icon" loading="lazy" />
					<span class="tech-name">Linux</span>
				</div>
				<div class="tech-item" data-tech="Git">
					<img src="https://skillicons.dev/icons?i=git" alt="Git" class="tech-icon" loading="lazy" />
					<span class="tech-name">Git</span>
				</div>
				<div class="tech-item" data-tech="GitHub">
					<img src="https://skillicons.dev/icons?i=github" alt="GitHub" class="tech-icon" loading="lazy" />
					<span class="tech-name">GitHub</span>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.tech-stack-section {
		margin-bottom: var(--space-16);
	}

	.tech-categories {
		display: flex;
		flex-direction: column;
		gap: var(--space-8);
		margin-top: var(--space-8);
	}

	.tech-category {
		padding: var(--space-6);
		background: var(--color-bg-secondary);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-xl);
	}

	.category-title {
		font-size: 1.125rem;
		font-weight: 700;
		color: var(--color-text);
		margin-bottom: var(--space-6);
		padding-bottom: var(--space-3);
		border-bottom: 2px solid var(--color-border);
	}

	.tech-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
		gap: var(--space-4);
	}

	.tech-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-4);
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		transition: all var(--transition-fast);
		cursor: pointer;
		position: relative;
	}

	.tech-item:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: 2px;
	}

	.tech-item:hover {
		transform: translateY(-4px);
		border-color: var(--color-primary);
		box-shadow: 0 8px 24px rgba(14, 165, 233, 0.2);
		background: var(--color-bg-secondary);
	}

	.tech-item:hover .tech-name {
		color: var(--color-primary);
	}

	.tech-icon {
		width: 48px;
		height: 48px;
		transition: transform var(--transition-fast);
	}

	.tech-item:hover .tech-icon {
		transform: scale(1.1);
	}

	.tech-name {
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--color-text-secondary);
		text-align: center;
		transition: color var(--transition-fast);
	}

	.tech-item::after {
		content: attr(data-tech);
		position: absolute;
		bottom: -40px;
		left: 50%;
		transform: translateX(-50%);
		background: var(--color-bg);
		color: var(--color-text);
		padding: var(--space-2) var(--space-3);
		border-radius: var(--radius);
		font-size: 0.75rem;
		opacity: 0;
		pointer-events: none;
		transition: opacity var(--transition-fast);
		border: 1px solid var(--color-border);
		white-space: nowrap;
		z-index: 10;
	}

	.tech-item:hover::after {
		opacity: 1;
	}

	@media (max-width: 768px) {
		.tech-grid {
			grid-template-columns: repeat(auto-fit, minmax(80px, 1fr));
			gap: var(--space-3);
		}

		.tech-icon {
			width: 40px;
			height: 40px;
		}

		.tech-item {
			padding: var(--space-3);
		}
	}
</style>

