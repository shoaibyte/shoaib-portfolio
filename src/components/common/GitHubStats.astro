---
// src/components/common/GitHubStats.astro
const githubUsername = 'sayanshoaib';
---

<section class="github-stats-section">
	<h2 class="section-title">GitHub Analytics</h2>
	<div class="github-stats-grid">
		<div class="github-stat-card">
			<img
				src={`https://github-readme-stats-eight-theta.vercel.app/api?username=${githubUsername}&show_icons=true&theme=tokyonight&include_all_commits=true&count_private=true`}
				alt="GitHub Stats"
				class="github-stat-image"
				loading="lazy"
			/>
		</div>
		<div class="github-stat-card">
			<img
				src={`https://github-readme-stats-eight-theta.vercel.app/api/top-langs/?username=${githubUsername}&layout=compact&langs_count=8&theme=tokyonight`}
				alt="Top Languages"
				class="github-stat-image"
				loading="lazy"
			/>
		</div>
		<div class="github-stat-card">
			<img
				src={`https://github-readme-streak-stats.herokuapp.com/?user=${githubUsername}&theme=tokyonight`}
				alt="GitHub Streak"
				class="github-stat-image"
				loading="lazy"
			/>
		</div>
	</div>
</section>

<style>
	.github-stats-section {
		margin-bottom: var(--space-16);
	}

	.github-stats-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-6);
		margin-top: var(--space-8);
	}

	.github-stat-card {
		background: var(--color-bg-secondary);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-xl);
		padding: var(--space-4);
		overflow: hidden;
		transition: all var(--transition-fast);
	}

	.github-stat-card:hover {
		transform: translateY(-4px);
		border-color: var(--color-primary);
		box-shadow: 0 8px 24px rgba(14, 165, 233, 0.15);
	}

	.github-stat-image {
		width: 100%;
		height: auto;
		border-radius: var(--radius-lg);
		display: block;
	}

	@media (max-width: 1024px) {
		.github-stats-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 768px) {
		.github-stat-card {
			padding: var(--space-3);
		}
	}
</style>

