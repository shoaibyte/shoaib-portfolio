---
// src/layouts/PortfolioLayout.astro
import Layout from './Layout.astro';
import Sidebar from '../components/layout/Sidebar.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

export interface Props {
    title: string;
    description?: string;
    isHome?: boolean;
    type?: 'website' | 'article';
    image?: string;
}

const { title, description, isHome = false, type, image } = Astro.props;
---

<Layout title={title} description={description} isHome={isHome} type={type} image={image}>
    <Fragment slot="head">
        <slot name="head" />
    </Fragment>
    <div class="layout">
        <Sidebar />

        <main id="main-content" class="main-content" tabindex="-1">
            <Header />
            <div class="content-wrapper">
                <slot />
            </div>
            <Footer />
        </main>
    </div>

    <style>
        .layout {
            display: flex;
            min-height: 100vh;
        }

        .main-content {
            flex: 1;
            padding: var(--space-8);
            margin-left: 280px;
        }

        .main-content:focus {
            outline: none;
        }

        .content-wrapper {
            max-width: 1200px;
            margin: 0 auto;
            width: 100%;
        }

        @media (max-width: 1024px) {
            .main-content {
                margin-left: 0;
                padding: var(--space-6);
            }
        }

        @media (max-width: 768px) {
            .main-content {
                padding: var(--space-4);
            }
        }
    </style>
</Layout>
